{
  "installCommand": "uv venv .venv --python 3.12 && uv pip install -r requirements.txt",
  "buildCommand": "bash app/build.sh",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
