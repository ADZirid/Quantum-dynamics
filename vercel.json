{
  "buildCommand": "bash app/build.sh",
  "installCommand": "uv pip install --system --python 3.12 -r app/requirements.txt",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/app/staticfiles/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
