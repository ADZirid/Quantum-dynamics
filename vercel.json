{
  "buildCommand": "bash app/build.sh",
  "installCommand": "uv pip install --system -r app/requirements.txt",
  "outputDirectory": "app/staticfiles",
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/app/staticfiles/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
